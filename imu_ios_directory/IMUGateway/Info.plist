<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.visionpipeline.IMUGateway</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>IMUGateway</string>
	<key>CFBundleDisplayName</key>
	<string>IMU Gateway</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSMotionUsageDescription</key>
	<string>IMU Gateway uses motion sensors to stream attitude, acceleration, and angular velocity to your host computer.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>iPhone Sensor Gateway sends live camera, depth, pose, and motion measurements to the selected host computer.</string>
	<key>NSCameraUsageDescription</key>
	<string>iPhone Sensor Gateway uses the rear camera and LiDAR depth sensor for synchronized RGB-D capture.</string>
